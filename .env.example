# Configuration checklist only. The Worker does not load this file at runtime.
# Configure every operational value in the Site's native environment/secret controls.
# Keep real values out of source, build artifacts, chat, and hosting JSON.

# Site-scoped identity returned by a real authenticated get_connector_identity call.
OWNER_USER_ID=

# Dedicated Telegram Bot API token; never human-account credentials.
TELEGRAM_BOT_TOKEN=

# Independently generated, 32-256 base64url characters: A-Z a-z 0-9 _ -
# Do not reuse the bot token or an MCP subscription signing key.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated positive numeric Telegram user IDs; no names or wildcards.
# Each approved private recipient's ID must be present in both ID lists.
TELEGRAM_ALLOWED_USER_IDS=

# Comma-separated positive numeric private Telegram chat IDs.
TELEGRAM_ALLOWED_CHAT_IDS=

# Comma-separated exact HTTPS origins observed from genuine ChatGPT subscriptions.
# No paths, queries, fragments, credentials, IP addresses, non-default ports, or wildcards.
MCP_CALLBACK_ORIGINS=

# Exact HTTPS deployment origin; no path, query, or fragment.
SITE_ORIGIN=

# DB is a D1 binding configured by the hosting manifest, not a string secret.
